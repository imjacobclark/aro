[Unit]
Description=Sonora LAN Library Hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sonora
Group=sonora
ExecStart=/usr/local/bin/sonora-server --config /etc/sonora/sonora.toml serve
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/sonora

[Install]
WantedBy=multi-user.target
