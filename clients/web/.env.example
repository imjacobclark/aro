# The hub's sync API. On Mercury this is the loopback address, because the container runs
# with host networking alongside aro-server.
ARO_HUB_URL=https://127.0.0.1:4848

# The admin token from the hub's aro.toml. This is the app's only credential, and it never
# leaves the server: the browser talks to /api/hub, and this process talks to the hub.
ARO_ADMIN_TOKEN=

# The hub's self-signed certificate, pinned rather than trusted through a public CA — the
# same posture the macOS client takes. The deploy script copies this off the hub.
ARO_HUB_CERT=/etc/aro-web/hub-cert.pem

# Optional: hex SHA-256 of the hub's certificate, checked in addition to the file above.
# ARO_HUB_FINGERPRINT=

# Development only. Skips certificate verification entirely so `npm run dev` can point at
# a hub whose certificate you have not copied locally. Never set this in the container.
# ARO_HUB_INSECURE=true

PORT=4851
